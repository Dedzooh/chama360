# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/chama_management_system?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=3000
APP_WEB_URL="http://localhost:5173"
NODE_ENV="development"
API_VERSION="v1"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173,https://localhost,capacitor://localhost"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH="uploads"

# AWS S3 Configuration (for document storage)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_S3_ENDPOINT=""
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_KMS_KEY_ID=""
DOCUMENT_HASH_SECRET=""

# M-Pesa Integration
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""
MPESA_SUBSCRIPTION_CALLBACK_URL=""
MPESA_ENVIRONMENT="sandbox"

# SMS Gateway Configuration
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_BASE_URL=""
# SMS endpoint must accept JSON: { "to", "message", "senderId" } with a Bearer API key.

# Email Configuration
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""

# KYC Provider Configuration
KYC_API_KEY=""
KYC_BASE_URL=""

# Logging Configuration
LOG_LEVEL="info"
SYSTEM_ADMIN_EMAILS="owner@example.com"
BILLING_BUSINESS_NAME="CHAMA360"
BILLING_BUSINESS_ADDRESS="Nairobi, Kenya"
BILLING_TAX_PIN=""
BILLING_VAT_RATE=0
SUPPORT_EMAIL="support@your-domain.example"
LOG_FILE="logs/app.log"

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET="your-session-secret-change-this-in-production"
# Generate once with: openssl rand -hex 32
MFA_ENCRYPTION_KEY=""
# Dedicated keyed-fingerprint secret; do not reuse JWT or document secrets.
IDENTITY_HASH_SECRET=""
# Set only after the retention period has been approved. When omitted, deletion
# requests disable access but automated anonymization remains paused.
ACCOUNT_DELETION_GRACE_DAYS=

# Background Jobs Configuration
BULL_REDIS_URL="redis://localhost:6379"

# Monitoring and Health Checks
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true

# Mobile release metadata
ANDROID_LATEST_VERSION="1.0.0"
ANDROID_MIN_SUPPORTED_VERSION="1.0.0"
ANDROID_UPDATE_URL="https://your-domain.example/downloads/chama360.apk"
ANDROID_FORCE_UPDATE=false
ANDROID_APK_SHA256=""
ANDROID_APK_SIZE_BYTES=
ANDROID_RELEASED_AT="2026-09-02T00:00:00.000Z"
ANDROID_RELEASE_NOTES="Security and reliability improvements."
