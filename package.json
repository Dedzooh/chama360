{
  "name": "chama-management-system",
  "version": "1.0.0",
  "description": "A comprehensive platform for managing savings groups (Chamas) in Kenya and East Africa",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:db:up": "docker compose --profile test up -d postgres-test redis",
    "test:db:reset": "docker compose --profile test rm -sf postgres-test redis && docker compose --profile test up -d postgres-test redis",
    "test:offline": "jest --config jest.config.offline.js --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:pbt": "jest --testNamePattern=\"Property:\"",
    "test:setup": "jest --config jest.config.simple.js",
    "verify-setup": "tsx src/scripts/verify-setup.ts",
    "release:audit": "tsx src/scripts/release-preflight.ts",
    "release:check": "tsx src/scripts/release-preflight.ts --production && node --env-file=.env.production node_modules/prisma/build/index.js migrate status && npm run type-check && npm --prefix client run build",
    "test:smoke": "tsx src/scripts/smoke-core-flow.ts",
    "identity:backfill": "tsx src/scripts/backfill-national-id-protection.ts",
    "platform:bootstrap-owner": "node dist/scripts/bootstrap-platform-owner.js",
    "contributions:reconcile": "tsx src/scripts/reconcile-monthly-contributions.ts",
    "contributions:penalties": "tsx src/scripts/reconcile-contribution-penalties.ts",
    "contributions:reminders": "tsx src/scripts/reconcile-contribution-reminders.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/scripts/seed.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "chama",
    "savings-group",
    "rosca",
    "asca",
    "financial-management",
    "kenya",
    "east-africa"
  ],
  "author": "Chama Management System Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@aws-sdk/client-s3": "^3.1127.0",
    "axios": "^1.13.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "express-winston": "^4.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.3",
    "qs": "^6.16.0",
    "redis": "^4.6.12",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "5.0.5",
    "@types/express-serve-static-core": "5.0.7",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "@types/express-serve-static-core": "5.0.7",
    "qs": "^6.16.0"
  }
}
