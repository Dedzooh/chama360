{
  "name": "client",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android",
    "lint": "eslint .",
    "preview": "vite preview",
    "phone:url": "node scripts/phone-dev.mjs url",
    "phone:devices": "node scripts/phone-dev.mjs devices",
    "phone:sync": "node scripts/phone-dev.mjs sync",
    "phone:install": "node scripts/phone-dev.mjs install",
    "mobile:assets": "node scripts/run-mobile-assets.mjs",
    "mobile:build": "npm run mobile:assets && npm run build && npx cap sync",
    "mobile:build:android": "npm run mobile:assets && npm run build:android && npx cap sync android",
    "mobile:sync": "npm run mobile:assets && npm run build:android && npx cap sync android",
    "mobile:sync:android": "npm run mobile:assets && npm run build:android && npx cap sync android",
    "mobile:add:android": "npx cap add android",
    "mobile:open:android": "npx cap open android",
    "mobile:release": "npm run mobile:assets && npm run build:android && npx cap sync android && cd android && gradlew.bat assembleRelease",
    "mobile:release-metadata": "node scripts/android-release-metadata.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.13.4",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.13.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
